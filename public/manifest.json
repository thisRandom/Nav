{
  "manifest_version": 3,
  "name": "Lantech Nav",
  "version": "1.1.0",
  "description": "极客风格内网感应导航插件",
  "icons": {
    "128": "icon.png"
  },
  "permissions": [
    "storage",
    "downloads"
  ],
  "action": {
    "default_title": "Lantech Nav"
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "host_permissions": [
    "https://suggestion.baidu.com/*",
    "https://192.168.10.254:8006/*",
    "https://cn.bing.com/*"
  ]
}